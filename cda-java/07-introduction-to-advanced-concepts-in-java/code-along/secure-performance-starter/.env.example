# Connection settings for the demo. Copy this file to .env and fill in your values.
# .env is git-ignored and loaded by application.properties at startup;
# a real environment variable with the same name always wins over .env.
# Never commit .env — this file documents the variable names only.

DB_URL=jdbc:postgresql://localhost:5432/ledger_demo
DB_USERNAME=postgres
DB_PASSWORD=change-me
