# LedgerCore runtime settings. Copy to .env and fill in real values.
# .env is git-ignored and read at runtime (see com.rti.ledgercore.config.Env);
# a real environment variable of the same name always wins over .env.
# Never commit .env — this file documents the variable names/shapes only.

# --- PostgreSQL connection -------------------------------------------------
# Update 'payments' to match your local PostgreSQL database name.
DB_URL=jdbc:postgresql://localhost:5432/ledger_core
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_POSTGRES_PASSWORD

# Postgres schema LedgerCore's tables are created in, so they never collide with
# other tables in the same database. Lowercase letters, digits, underscore.
DB_SCHEMA=ledgercore

# always = run schema.sql + data.sql (drop, recreate, reseed) on every start
# never  = leave the existing tables and data alone
DB_INIT_MODE=always

# --- Field encryption ------------------------------------------------------
# Base64-encoded 32-byte AES-256 key for com.rti.ledgercore.crypto.FieldCipher.
# The starter FieldCipher does not use this key yet (see its TODO) — once the
# lab wires up real AES-GCM encryption, this becomes the key it reads.
#
# Generate a real key with:
#   openssl rand -base64 32
LEDGERCORE_DATA_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY
