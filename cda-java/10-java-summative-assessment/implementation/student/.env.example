# VitalLedger — required environment configuration (EXAMPLE ONLY).
# Copy to `.env` and fill in real values. `.env` is git-ignored and must NEVER be committed.
# Do not put real key material in this file.

# ---- Encryption at rest (REQUIRED) ----
# Base64-encoded AES key (16, 24, or 32 raw bytes -> AES-128/192/256).
# Generate one with:  openssl rand -base64 32
# The app FAILS FAST at startup if this is unset. Binds to property `vitalledger.aes.key`.
VITALLEDGER_AES_KEY=

# ---- LLM provider credential (OPTIONAL) ----
# Only needed if a real LLM backend replaces the default local stub client.
# Left blank => the app uses the no-network StubLlmClient (no outbound model call).
# Binds to property `vitalledger.llm.api-key`.
VITALLEDGER_LLM_API_KEY=
