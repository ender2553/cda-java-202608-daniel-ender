LLM_API_BASE=http://127.0.0.1:9999
LLM_MODEL=fake-model
# The fake server ignores the key, but the app requires one to be set.
LLM_API_KEY=not-a-real-key

# Timeout is shorter than fake_llm.py's 15-second slow mode, so --mode slow
# triggers a timeout.
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_MAX_INPUT_CHARS=2000
LLM_MAX_OUTPUT_LENGTH=8000
