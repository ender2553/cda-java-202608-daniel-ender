# Copy to .env and fill in real values. NEVER commit your real .env.
# The service reads secrets from the environment only — never from source.

LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.your-provider.example
LLM_MODEL=your-model-name

# Optional tuning (defaults shown):
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=5
LLM_MAX_INPUT_CHARS=2000
LLM_MAX_OUTPUT_LENGTH=8000
