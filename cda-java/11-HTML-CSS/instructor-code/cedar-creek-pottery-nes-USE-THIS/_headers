# Response-header baseline (Netlify / Cloudflare Pages format).
# The CSP must match the <meta> tag on each page exactly.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://unpkg.com https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://nostalgic-css.github.io https://user-images.githubusercontent.com https://visionary-mochi-3391c5.netlify.app; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
