# Copy this file to ".env". The app connects as sqli_owner, a NON-superuser role
# that owns the sqli_demo tables (created by schema.sql with the password below).
# It can read/write/DROP those tables -- enough for the "vandalise" demos -- but
# it is NOT a superuser, so a payload cannot run OS commands or read server files.
# .env is git-ignored, so nothing here is committed.
DB_URL=jdbc:postgresql://localhost:5432/sqli_demo
DB_USERNAME=sqli_owner
DB_PASSWORD=sqli_owner_pw
